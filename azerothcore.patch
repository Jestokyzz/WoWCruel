+        case 58778:
+        case 58779:
+        case 58780:
+            return true;
+        // Warrior: Improved Spell Reflection.
+        case 59725:
+            return true;
+        // Rogue: Honor Among Thieves.
+        case 51698:
+        case 51700:
+        case 51701:
+            return true;
+        // Paladin: Crusader Aura's third effect and Divine Sacrifice.
+        case 32223:
