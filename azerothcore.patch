+#include "WorldSession.h"
 #include <unordered_map>
 
 #include "BattlegroundUtils.h"
 
+namespace
+{
+bool IsSolitaryRatedBotPair(GroupQueueInfo const* first, GroupQueueInfo const* second);
+
+bool QueueGroupsCanShareMatch(GroupQueueInfo const* first, GroupQueueInfo const* second)
+{
+    if (!first || !second)
+        return false;
+
+    // Rated Solitary arenas are private, owner-bound lobbies.  Never let an
+    // unrelated or incomplete legacy bot team satisfy such a queue.
+    if ((first->IsSolitary || second->IsSolitary) && first->IsRated && second->IsRated &&
+        first->ArenaType && second->ArenaType)
+        return IsSolitaryRatedBotPair(first, second);
+
+    if (first->IsSolitary)
+        return !second->HasRealPlayer;
+
+    if (second->IsSolitary)
+        return !first->HasRealPlayer;
+
+    return true;
+}
+
+bool IsSolitaryRatedBotPair(GroupQueueInfo const* first, GroupQueueInfo const* second)
+{
+    if (!first || !second)
+        return false;
+
+    if (!first->IsSolitary || !second->IsSolitary || !first->IsRated || !second->IsRated ||
+        !first->ArenaType || first->ArenaType != second->ArenaType ||
+        first->Players.size() != first->ArenaType || second->Players.size() != second->ArenaType ||
+        !first->SolitaryOwnerGuid || first->SolitaryOwnerGuid != second->SolitaryOwnerGuid ||
+        first->HasRealPlayer == second->HasRealPlayer)
+        return false;
+
+    GroupQueueInfo const* solitary = first->IsSolitary && first->HasRealPlayer ? first :
+        second->IsSolitary && second->HasRealPlayer ? second : nullptr;
+    GroupQueueInfo const* bots = solitary == first ? second : first;
+    return solitary && bots && bots->IsSolitary && !bots->HasRealPlayer;
+}
+
+void NormalizeSolitaryRatedBotMmr(GroupQueueInfo* first, GroupQueueInfo* second)
+{
+    if (!IsSolitaryRatedBotPair(first, second))
+        return;
+
+    GroupQueueInfo* solitary = first->IsSolitary && first->HasRealPlayer ? first : second;
+    GroupQueueInfo* bots = solitary == first ? second : first;
+    uint32 const storedBotMmr = bots->ArenaMatchmakerRating;
+    bots->ArenaMatchmakerRating = solitary->ArenaMatchmakerRating;
+
+    LOG_INFO("bg.arena",
+        "Solitary rated queue: virtual team {} (MMR {}) paired with bot-only team {} "
+        "(stored MMR {}, effective MMR {})",
+        solitary->ArenaTeamId, solitary->ArenaMatchmakerRating, bots->ArenaTeamId,
+        storedBotMmr, bots->ArenaMatchmakerRating);
+}
+}
