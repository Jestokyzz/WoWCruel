+    {
+        player->SendEquipError(EQUIP_ERR_NONE, item, nullptr);
+        player->RemoveAurasDueToSpell(26013);
+        player->RemoveAurasDueToSpell(71041);
+        player->RemoveAurasDueToSpell(71328);
+        player->DestroyItemCount(item->GetEntry(), 1, true);
+        return true;
+    }
+};
+
+class item_unlock_continent_flight_paths : public ItemScript
+{
+public:
+    item_unlock_continent_flight_paths() : ItemScript("item_unlock_continent_flight_paths") { }
+
+    bool OnUse(Player* player, Item* item, SpellCastTargets const& /*targets*/) override
+    {
+        uint32 const itemId = item->GetEntry();
+        TaxiMask const& factionMask = player->GetTeamId() == TEAM_ALLIANCE
+            ? sAllianceTaxiNodesMask : sHordeTaxiNodesMask;
+        uint32 learned = 0;
+
+        for (TaxiNodesEntry const* node : sTaxiNodesStore)
+        {
+            if (!node || !IsNodeOnItemContinent(node, itemId))
+                continue;
+
+            uint8 const field = uint8((node->ID - 1) / 32);
+            uint32 const submask = 1 << ((node->ID - 1) % 32);
+            if ((factionMask[field] & submask) && player->m_taxi.SetTaximaskNode(node->ID))
+                ++learned;
+        }
+
+        if (!learned)
+        {
+            player->SendEquipError(EQUIP_ERR_NONE, item, nullptr);
+            ChatHandler(player->GetSession()).SendNotification("Все доступные маршруты этого континента уже изучены.");
+            return true;
+        }
+
+        player->SendEquipError(EQUIP_ERR_NONE, item, nullptr);
+        player->SendPlaySpellVisual(SPELL_VISUAL_LEARN_SKILL);
+        player->SendPlaySpellImpact(player->GetGUID(), SPELL_IMPACT_LEARN_SKILL);
+        player->DestroyItemCount(itemId, 1, true);
+        ChatHandler(player->GetSession()).SendNotification("Изучено новых маршрутов полета: {}.", learned);
+        return true;
+    }
+
+private:
+    static bool IsNodeOnItemContinent(TaxiNodesEntry const* node, uint32 itemId)
+    {
+        switch (itemId)
+        {
+            case ITEM_FLIGHT_PATHS_NORTHREND:
+                return node->map_id == 571;
+            case ITEM_FLIGHT_PATHS_OUTLAND:
+                return node->map_id == 530 && node->ID != 82 && node->ID != 83 &&
+                    node->ID != 93 && node->ID != 94;
+            case ITEM_FLIGHT_PATHS_EASTERN_KINGDOMS:
+                return node->map_id == 0 || node->ID == 82 || node->ID == 83;
+            case ITEM_FLIGHT_PATHS_KALIMDOR:
+                return node->map_id == 1 || node->ID == 93 || node->ID == 94;
+            default:
+                return false;
+        }
+    }
+};
