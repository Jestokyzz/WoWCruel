+constexpr uint32 SOLO_RATED_ARENA_TEAM_ID_BASE = 0xF0000000;
+
+struct SoloRatedArenaRating
+{
+    bool Valid = false;
+    uint32 Rating = 1500;
+    uint32 MatchmakerRating = 1500;
+};
+
+bool IsSoloRatedArenaTeam(uint32 teamId)
+{
+    return teamId >= SOLO_RATED_ARENA_TEAM_ID_BASE;
+}
+
+SoloRatedArenaRating LoadSoloRatedArenaRating(uint32 teamId)
+{
+    SoloRatedArenaRating result;
+    if (!IsSoloRatedArenaTeam(teamId))
+        return result;
+
+    CharacterDatabasePreparedStatement* statement =
+        CharacterDatabase.GetPreparedStatement(CHAR_SEL_SOLO_ARENA_RATING_BY_VIRTUAL_TEAM);
+    statement->SetData(0, teamId);
+    if (PreparedQueryResult query = CharacterDatabase.Query(statement))
+    {
+        Field* fields = query->Fetch();
+        result.Valid = true;
+        result.Rating = fields[0].Get<uint32>();
+        result.MatchmakerRating = fields[1].Get<uint32>();
+    }
+    return result;
+}
+
+uint32 ApplyArenaRatingChange(uint32 rating, int32 change)
+{
+    return change < 0 && uint32(-change) > rating ? 0 : uint32(int64(rating) + change);
+}
+
+void SaveSoloRatedArenaRating(uint32 teamId, uint32 rating, uint32 matchmakerRating, bool won)
+{
+    CharacterDatabasePreparedStatement* statement =
+        CharacterDatabase.GetPreparedStatement(CHAR_UPD_SOLO_ARENA_RATING_RESULT);
+    statement->SetData(0, rating);
+    statement->SetData(1, matchmakerRating);
+    statement->SetData(2, won ? 1 : 0);
+    statement->SetData(3, won ? 1 : 0);
+    statement->SetData(4, teamId);
+    CharacterDatabase.Execute(statement);
+}
+}
