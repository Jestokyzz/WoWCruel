+    static bool HandlePvpPortCommand(ChatHandler* handler, uint32 bgTypeIdRaw)
+    {
+        WorldSession* session = handler->GetSession();
+        if (!session)
+            return false;
+
+        Player* player = session->GetPlayer();
+        if (!player || !player->IsInWorld() || player->IsBeingTeleported() ||
+            player->GetMap()->GetEntry()->Instanceable() || player->InBattlegroundQueue())
+        {
+            handler->SendErrorMessage("Player must be in the open world and outside battleground queues.");
+            return false;
+        }
+
+        bool const isArena = bgTypeIdRaw == 870 || bgTypeIdRaw == 871;
+        if (bgTypeIdRaw != 108 && bgTypeIdRaw != 120 && !isArena)
+        {
+            handler->SendErrorMessage("Supported ids: 108 Twin Peaks, 120 Battle for Gilneas, 870 Tol'Viron, 871 Tiger's Peak.");
+            return false;
+        }
+
+        // BattlegroundTypeId is uint8 in the 3.3.5a core. Keep the convenient
+        // user-facing port numbers while mapping the two custom arenas to free
+        // internal IDs that can actually be represented by the core.
+        BattlegroundTypeId bgTypeId = bgTypeIdRaw == 870 ? BattlegroundTypeId(102) :
+            bgTypeIdRaw == 871 ? BattlegroundTypeId(103) : BattlegroundTypeId(bgTypeIdRaw);
+
+        Battleground* bgTemplate = sBattlegroundMgr->GetBattlegroundTemplate(bgTypeId);
+        if (!bgTemplate)
+        {
+            handler->PSendSysMessage("Battleground template {} is not loaded.", bgTypeIdRaw);
+            return false;
+        }
+
+        PvPDifficultyEntry const* bracket = GetBattlegroundBracketByLevel(bgTemplate->GetMapId(), player->GetLevel());
+        if (!bracket)
+        {
+            handler->PSendSysMessage("No PvP bracket for map {} and level {}.", bgTemplate->GetMapId(), player->GetLevel());
+            return false;
+        }
+
+        Battleground* bg = sBattlegroundMgr->CreateNewBattleground(bgTypeId, bracket, isArena ? ARENA_TYPE_2v2 : ARENA_TYPE_NONE, false);
+        if (!bg)
+        {
+            handler->PSendSysMessage("Could not create battleground {}.", bgTypeIdRaw);
+            return false;
+        }
+
+        bg->StartBattleground();
+        TeamId teamId = player->GetTeamId(true);
+        player->SetEntryPoint();
+
+        uint32 queueSlot = 0;
+        WorldPacket data;
+        sBattlegroundMgr->BuildBattlegroundStatusPacket(&data, bg, queueSlot, STATUS_IN_PROGRESS, 0,
+            bg->GetStartTime(), bg->GetArenaType(), teamId);
+        player->SendDirectMessage(&data);
+        sLFGMgr->LeaveAllLfgQueues(player->GetGUID(), false);
+
+        bg->IncreaseInvitedCount(teamId);
+        player->SetBattlegroundId(bg->GetInstanceID(), bg->GetBgTypeID(), queueSlot, true, false, teamId);
+        if (!sBattlegroundMgr->SendToBattleground(player, bg->GetInstanceID(), bg->GetBgTypeID()))
+        {
+            bg->DecreaseInvitedCount(teamId);
+            player->SetBattlegroundId(0, BATTLEGROUND_TYPE_NONE, PLAYER_MAX_BATTLEGROUND_QUEUES, false, false, TEAM_NEUTRAL);
+            handler->SendErrorMessage("Battleground was created, but teleport failed.");
+            return false;
+        }
+
+        handler->PSendSysMessage("Entering PvP port {} (map {}, instance {}).", bgTypeIdRaw, bg->GetMapId(), bg->GetInstanceID());
+        return true;
+    }
