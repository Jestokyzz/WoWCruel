+uint32 RemoveAppliedSolitaryOutgoingMultiplier(DamageInfo const& damageInfo, uint32 damage)
+{
+    if (!damage)
+        return 0;
+
+    Unit* victim = damageInfo.GetVictim();
+    Map* map = victim ? victim->GetMap() : nullptr;
+    if (!map || !map->IsDungeon() || map->IsBattlegroundOrArena())
+        return damage;
+
+    Unit* attacker = damageInfo.GetAttacker();
+    Player* sourcePlayer = attacker ? attacker->GetCharmerOrOwnerPlayerOrPlayerItself() : nullptr;
+    Player* targetPlayer = victim->GetCharmerOrOwnerPlayerOrPlayerItself();
+    if (!sourcePlayer || !sourcePlayer->IsSolitary() || targetPlayer)
+        return damage;
+
+    // A derived damaging spell will pass through the regular Solitary x10 hook
+    // itself. Remove the x10 already present in its parent hit so it is not
+    // applied twice. Round to the nearest integer and preserve positive damage.
+    return static_cast<uint32>(std::max<uint64>(1, (uint64(damage) + 5) / 10));
+}
+}
+
+uint32 DamageInfo::GetDamageForDerivedEffect() const
+{
+    return RemoveAppliedSolitaryOutgoingMultiplier(*this, GetDamage());
+}
+
+uint32 DamageInfo::GetUnmitigatedDamageForDerivedEffect() const
+{
+    return RemoveAppliedSolitaryOutgoingMultiplier(*this, GetUnmitigatedDamage());
+}
