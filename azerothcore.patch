+enum FlightPathMapItems
+{
+    ITEM_COMPLETE_NORTHREND_QUESTS      = 900114,
+    ITEM_FLIGHT_PATHS_NORTHREND         = 900110,
+    ITEM_FLIGHT_PATHS_OUTLAND           = 900111,
+    ITEM_FLIGHT_PATHS_EASTERN_KINGDOMS  = 900112,
