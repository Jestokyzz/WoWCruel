+    SPELL_VISUAL_LEARN_SKILL            = 179,
+    SPELL_IMPACT_LEARN_SKILL            = 362
+};
+
+bool IsNorthrendQuest(Quest const* quest)
+{
+    if (!quest)
+        return false;
+
+    switch (quest->GetZoneOrSort())
+    {
+        case 65:
+        case 66:
+        case 67:
+        case 210:
+        case 394:
+        case 495:
+        case 2817:
+        case 3537:
+        case 3711:
+        case 4197:
+        case 4395:
+            return true;
+        default:
+            return false;
+    }
+}
+
+class item_complete_northrend_quests : public ItemScript
+{
+public:
+    item_complete_northrend_quests() : ItemScript("item_complete_northrend_quests") { }
+
+    bool OnUse(Player* player, Item* item, SpellCastTargets const& /*targets*/) override
+    {
+        player->SendEquipError(EQUIP_ERR_NONE, item, nullptr);
+        uint32 completed = 0;
+
+        for (auto const& [questId, quest] : sObjectMgr->GetQuestTemplates())
+        {
+            if (!IsNorthrendQuest(quest) || player->IsQuestRewarded(questId))
+                continue;
+
+            player->SetRewardedQuest(questId);
+            ++completed;
+        }
+
+        if (!completed)
+        {
+            ChatHandler(player->GetSession()).SendNotification("Все задания Нордскола уже выполнены.");
+            return true;
+        }
+
+        player->SendPlaySpellVisual(SPELL_VISUAL_LEARN_SKILL);
+        player->SendPlaySpellImpact(player->GetGUID(), SPELL_IMPACT_LEARN_SKILL);
+        player->DestroyItemCount(item->GetEntry(), 1, true);
+        ChatHandler(player->GetSession()).SendNotification("Отмечено выполненными заданий Нордскола: {}.", completed);
+        return true;
+    }
+};
+
