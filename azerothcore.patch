+void WorldSession::CompletePendingSolitaryArenaJoin(ObjectGuid battlemasterGuid, uint8 arenaSlot, bool rated)
+{
+    if (!_player || !_player->IsSolitary() || _player->InBattleground())
+        return;
+
+    ArenaType arenaType = ARENA_TYPE_NONE;
+    switch (arenaSlot)
+    {
+        case 0:
+            arenaType = ARENA_TYPE_2v2;
+            break;
+        case 1:
+            arenaType = ARENA_TYPE_3v3;
+            break;
+        case 2:
+            arenaType = ARENA_TYPE_5v5;
+            break;
+        default:
+            return;
+    }
+
+    BattlegroundQueueTypeId const queueType =
+        BattlegroundMgr::BGQueueTypeId(BATTLEGROUND_AA, arenaType);
+    BattlegroundQueue& queue = sBattlegroundMgr->GetBattlegroundQueue(queueType);
+    GroupQueueInfo pendingInfo;
+
+    // Completion is valid only while the exact visible one-player placeholder
+    // still exists. If the player cancelled it, never resurrect the request.
+    if (!_player->InBattlegroundQueueForBattlegroundQueueType(queueType) ||
+        !queue.GetPlayerGroupInfoData(_player->GetGUID(), &pendingInfo) ||
+        !pendingInfo.IsSolitary || pendingInfo.IsRated != rated ||
+        pendingInfo.ArenaType != arenaType || pendingInfo.Players.size() != 1)
+        return;
+
+    queue.RemovePlayer(_player->GetGUID(), true);
+    _player->RemoveBattlegroundQueueId(queueType);
+    LOG_INFO("bg.arena", "Solitary arena: replacing visible pending queue with prepared {}v{} cohort for {} ({})",
+        uint32(arenaType), uint32(arenaType), _player->GetName(), _player->GetGUID().ToString());
+
+    WorldPacket packet(CMSG_BATTLEMASTER_JOIN_ARENA, 16);
+    packet << battlemasterGuid << arenaSlot << uint8(1) << uint8(rated ? 1 : 0);
+
+    _completingSolitaryArenaJoin = true;
+    HandleBattlemasterJoinArena(packet);
+    _completingSolitaryArenaJoin = false;
+}
