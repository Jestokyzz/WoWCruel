+#include <algorithm>
+#include <cmath>
+
+namespace
+{
+uint32 GetSoloArenaPoints(uint32 rating, uint8 arenaSlot)
+{
+    float points;
+    if (rating <= 1500)
+    {
+        if (sArenaSeasonMgr->GetCurrentSeason() < 6 && !sWorld->getIntConfig(CONFIG_LEGACY_ARENA_POINTS_CALC))
+            points = float(rating) * 0.22f + 14.0f;
+        else
+            points = 344.0f;
+    }
+    else
+        points = 1511.26f / (1.0f + 1639.28f * std::exp(-0.00412f * float(rating)));
+
+    if (arenaSlot == 0)
+        points *= sWorld->getRate(RATE_ARENA_POINTS_2V2);
+    else if (arenaSlot == 1)
+        points *= sWorld->getRate(RATE_ARENA_POINTS_3V3);
+
+    points *= sWorld->getRate(RATE_ARENA_POINTS);
+    return uint32(points);
+}
+}
