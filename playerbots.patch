+void RandomPlayerbotMgr::RequestSolitaryArenaAssistants(Player* requester, ObjectGuid battlemasterGuid,
+    uint8 arenaSlot, uint8 teamSize, bool rated)
+{
+    if (!requester || !requester->IsSolitary() || teamSize < ARENA_TYPE_2v2)
         return;
+
+    pendingSolitaryArenaRegistrations[requester->GetGUID().GetCounter()] = {
+        battlemasterGuid, arenaSlot, teamSize, rated, time(nullptr) };
+
+    BattlegroundQueueTypeId queueType = teamSize == ARENA_TYPE_2v2 ? BATTLEGROUND_QUEUE_2v2 :
+        (teamSize == ARENA_TYPE_3v3 ? BATTLEGROUND_QUEUE_3v3 : BATTLEGROUND_QUEUE_5v5);
+    uint8 const botCount = rated ? teamSize * 2 - 1 : teamSize - 1;
+    for (uint8 index = 1; index <= botCount; ++index)
+        CreateSolitaryActivityBotInternal(requester, requester->GetTeamId(), queueType, rated,
+            0x100u + index, {});
+    SetNextCheckDelay(1);
+}
