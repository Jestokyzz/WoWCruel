+    }
+
+    if (!solitaryAccountsPendingCleanup.empty())
+    {
+        std::set<uint32> accounts = std::move(solitaryAccountsPendingCleanup);
+        solitaryAccountsPendingCleanup.clear();
+        for (uint32 accountId : accounts)
+        {
+            std::vector<uint64> pendingNameIds;
+            pendingSolitaryActivityBots.erase(
+                std::remove_if(pendingSolitaryActivityBots.begin(), pendingSolitaryActivityBots.end(),
+                    [accountId, &pendingNameIds](PendingSolitaryActivityBot const& pending)
+                    {
+                        if (pending.info.accountId != accountId)
+                            return false;
+                        if (pending.info.namePoolId)
