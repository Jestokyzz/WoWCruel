+    pending.botName = nameFields[1].Get<std::string>();
+    CharacterDatabase.DirectExecute(
+        "UPDATE solitary_bot_name_pool SET state = 1, reservation_token = {}, reserved_at = UNIX_TIMESTAMP() "
+        "WHERE name_id = {} AND state = 0",
+        pending.reservationToken, pending.info.namePoolId);
+    QueryResult reservationResult = CharacterDatabase.Query(
+        "SELECT name FROM solitary_bot_name_pool "
+        "WHERE name_id = {} AND state = 1 AND reservation_token = {}",
+        pending.info.namePoolId, pending.reservationToken);
+    if (!reservationResult)
+    {
+        LOG_ERROR("playerbots", "Solitary activity: failed to reserve WCL name {}", pending.botName);
+        return false;
+    }
+
+    for (uint8 attempt = 0; attempt < 20; ++attempt)
+    {
+        uint32 accountToken = ++solitaryActivitySequence;
+        pending.accountName = Acore::StringFormat("SAB{:08X}{:03X}", getMSTime(), accountToken & 0xFFF);
+        AccountOpResult result = sAccountMgr->CreateAccount(pending.accountName, pending.accountName);
+        if (result == AOR_OK)
+        {
+            pendingSolitaryActivityBots.push_back(std::move(pending));
+            LOG_INFO("playerbots", "Solitary activity: queued exact-name bot creation ({})", reason);
+            return true;
+        }
+        if (result != AOR_NAME_ALREADY_EXIST)
+            break;
+    }
+
+    CharacterDatabase.DirectExecute(
+        "UPDATE solitary_bot_name_pool SET state = 0, reservation_token = NULL, reserved_at = NULL "
+        "WHERE name_id = {} AND state = 1 AND reservation_token = {}",
+        pending.info.namePoolId, pending.reservationToken);
+    LOG_ERROR("playerbots", "Solitary activity: failed to create temporary account ({})", reason);
+    return false;
+}
