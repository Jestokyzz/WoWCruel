 using namespace lfg;
 
+uint32 LfgJoinAction::GetRolesForPlayer(Player* player)
+{
+    if (!player)
+        return PLAYER_ROLE_NONE;
+
+    uint8 spec = AiFactory::GetPlayerSpecTab(player);
+    switch (player->getClass())
+    {
+        case CLASS_DRUID:
+            if (spec == 2) return PLAYER_ROLE_HEALER;
+            if (spec == 1 && player->HasAura(16931)) return PLAYER_ROLE_TANK;
+            return PLAYER_ROLE_DAMAGE;
+        case CLASS_PALADIN:
+            return spec == 1 ? PLAYER_ROLE_TANK : (!spec ? PLAYER_ROLE_HEALER : PLAYER_ROLE_DAMAGE);
+        case CLASS_PRIEST:
+            return spec != 2 ? PLAYER_ROLE_HEALER : PLAYER_ROLE_DAMAGE;
+        case CLASS_SHAMAN:
+            return spec == 2 ? PLAYER_ROLE_HEALER : PLAYER_ROLE_DAMAGE;
+        case CLASS_WARRIOR:
+            return spec == 2 ? PLAYER_ROLE_TANK : PLAYER_ROLE_DAMAGE;
+        case CLASS_DEATH_KNIGHT:
+            return spec == 0 ? PLAYER_ROLE_TANK : PLAYER_ROLE_DAMAGE;
+        default:
+            return PLAYER_ROLE_DAMAGE;
+    }
+}
+
+namespace
+{
+uint8 CountPvpEquipment(Player const* bot)
+{
+    uint8 count = 0;
+    for (uint8 slot = EQUIPMENT_SLOT_START; slot < EQUIPMENT_SLOT_END; ++slot)
+    {
+        if (slot == EQUIPMENT_SLOT_BODY || slot == EQUIPMENT_SLOT_TABARD)
+            continue;
+        if (bot->GetItemByPos(INVENTORY_SLOT_BAG_0, slot))
+            ++count;
+    }
+    return count;
+}
+
+bool CanFillRole(Player* bot, uint32 role)
+{
+    if (!bot)
+        return false;
+    if (role == PLAYER_ROLE_TANK)
+        return bot->IsClass(CLASS_WARRIOR) || bot->IsClass(CLASS_PALADIN) ||
+               bot->IsClass(CLASS_DRUID) || bot->IsClass(CLASS_DEATH_KNIGHT);
+    if (role == PLAYER_ROLE_HEALER)
+        return bot->IsClass(CLASS_PRIEST) || bot->IsClass(CLASS_PALADIN) ||
+               bot->IsClass(CLASS_SHAMAN) || bot->IsClass(CLASS_DRUID);
+    return true;
+}
+
+uint8 SpecForRole(Player* bot, uint32 role)
+{
+    if (role == PLAYER_ROLE_TANK)
+    {
+        if (bot->IsClass(CLASS_WARRIOR)) return 2;
+        if (bot->IsClass(CLASS_PALADIN)) return 1;
+        if (bot->IsClass(CLASS_DRUID)) return 1;
+        if (bot->IsClass(CLASS_DEATH_KNIGHT)) return 0;
+    }
+    else if (role == PLAYER_ROLE_HEALER)
+    {
+        if (bot->IsClass(CLASS_PRIEST)) return 0;
+        if (bot->IsClass(CLASS_PALADIN)) return 0;
+        if (bot->IsClass(CLASS_SHAMAN)) return 2;
+        if (bot->IsClass(CLASS_DRUID)) return 2;
+    }
+
+    if (bot->IsClass(CLASS_PRIEST)) return 2;
+    if (bot->IsClass(CLASS_PALADIN)) return 2;
+    if (bot->IsClass(CLASS_SHAMAN)) return 1;
+    if (bot->IsClass(CLASS_DRUID)) return 0;
+    if (bot->IsClass(CLASS_WARRIOR)) return 0;
+    if (bot->IsClass(CLASS_DEATH_KNIGHT)) return 1;
+    return 0;
+}
+}
+
+uint16 LfgJoinAction::SelectSolitaryGearTier(bool pvp, uint16 targetItemLevel)
+{
+    uint8 const activity = pvp ? 1 : 2;
+    QueryResult result = WorldDatabase.Query(
+        "SELECT tier_id FROM solitary_bot_gear_tier WHERE activity = {} "
+        "ORDER BY ABS(CAST(reference_item_level AS SIGNED) - {}) ASC, sort_order ASC LIMIT 1",
+        activity, targetItemLevel);
+    return result ? result->Fetch()[0].Get<uint16>() : 0;
+}
+
+bool LfgJoinAction::ApplySolitaryGearTemplate(Player* bot, bool pvp, uint16 tierId,
+    uint16 targetItemLevel, uint32 role, uint32* appliedTemplateId)
+{
+    if (!bot || !GET_PLAYERBOT_AI(bot) || !bot->IsSolitaryActivityBot())
+        return false;
+
+    if (!tierId)
+        tierId = SelectSolitaryGearTier(pvp, targetItemLevel);
+    if (!tierId)
+        return false;
+
+    std::string roleFilter;
+    if (!pvp && role)
+        roleFilter = Acore::StringFormat(" AND role_mask = {}", role);
+    QueryResult result = WorldDatabase.Query(
+        "SELECT template_id, spec_index, average_item_level "
+        "FROM solitary_bot_gear_template "
+        "WHERE verified = 1 AND tier_id = {} AND class_id = {}{} "
+        "ORDER BY ABS(CAST(average_item_level AS SIGNED) - {}) ASC, template_id ASC",
+        tierId, bot->getClass(), roleFilter, targetItemLevel);
+    if (!result && !pvp && role)
+    {
+        result = WorldDatabase.Query(
+            "SELECT template_id, spec_index, average_item_level "
+            "FROM solitary_bot_gear_template "
+            "WHERE verified = 1 AND tier_id = {} AND class_id = {} "
+            "ORDER BY ABS(CAST(average_item_level AS SIGNED) - {}) ASC, template_id ASC",
+            tierId, bot->getClass(), targetItemLevel);
+    }
+    if (!result)
+    {
+        LOG_ERROR("playerbots", "Solitary gear: no verified template for tier {}, class {}, role {}",
+            tierId, bot->getClass(), role);
+        return false;
+    }
+
+    do
+    {
+        Field* fields = result->Fetch();
+        uint32 const templateId = fields[0].Get<uint32>();
+        uint8 const specIndex = fields[1].Get<uint8>();
+        float const templateItemLevel = fields[2].Get<float>();
+        PlayerbotFactory::InitTalentsBySpecNo(bot, specIndex, true);
+        PlayerbotFactory factory(bot, bot->GetLevel(), ITEM_QUALITY_EPIC);
+        if (!factory.ApplyEquipmentTemplate(templateId))
+        {
+            LOG_WARN("playerbots", "Solitary gear: rejected template {} for {}, trying the next verified template",
+                templateId, bot->GetName());
+            continue;
+        }
+
+        factory.ApplyEnchantAndGemsNew();
+        bot->DurabilityRepairAll(false, 1.0f, false);
+        bot->SaveToDB(false, false);
+        if (appliedTemplateId)
+            *appliedTemplateId = templateId;
+
+        LOG_INFO("playerbots", "Solitary gear: applied template {} (tier {}, spec {}, ilvl {}) to {}",
+            templateId, tierId, specIndex, templateItemLevel, bot->GetName());
+        return true;
+    } while (result->NextRow());
+
+    LOG_ERROR("playerbots", "Solitary gear: every verified template failed for tier {}, class {}, role {}",
+        tierId, bot->getClass(), role);
+    return false;
+}
+
+void LfgJoinAction::FillPlayerQueue(Player* player, uint32 playerRoles, std::set<uint32> const& dungeons)
+{
+    if (!player || dungeons.empty())
+        return;
+
+    uint32 tanks = (playerRoles & PLAYER_ROLE_TANK) ? 1 : 0;
+    uint32 healers = (playerRoles & PLAYER_ROLE_HEALER) ? 1 : 0;
+    uint32 damage = (!tanks && !healers) || (playerRoles & PLAYER_ROLE_DAMAGE) ? 1 : 0;
+
+    if (Group* group = player->GetGroup())
+    {
+        for (GroupReference* reference = group->GetFirstMember(); reference; reference = reference->next())
+        {
+            Player* member = reference->GetSource();
+            if (!member || member == player)
+                continue;
+            uint32 role = GetRolesForPlayer(member);
+            if (role & PLAYER_ROLE_TANK) ++tanks;
+            else if (role & PLAYER_ROLE_HEALER) ++healers;
+            else ++damage;
+        }
+    }
+
+    PlayerBotMap bots = sRandomPlayerbotMgr.GetAllBots();
+    for (auto const& entry : bots)
+    {
+        Player* queuedBot = entry.second;
+        if (!queuedBot || queuedBot->GetGroup() ||
+            sLFGMgr->GetState(queuedBot->GetGUID()) != LFG_STATE_QUEUED)
+            continue;
+
+        LfgDungeonSet const& queuedDungeons = sLFGMgr->GetSelectedDungeons(queuedBot->GetGUID());
+        if (queuedDungeons.size() != dungeons.size() ||
+            !std::equal(queuedDungeons.begin(), queuedDungeons.end(), dungeons.begin()))
+            continue;
+
+        uint32 role = GetRolesForPlayer(queuedBot);
+        if ((role & PLAYER_ROLE_TANK) && tanks < 1) ++tanks;
+        else if ((role & PLAYER_ROLE_HEALER) && healers < 1) ++healers;
+        else if (damage < 3) ++damage;
+    }
+
+    std::vector<uint32> neededRoles;
+    while (tanks++ < 1) neededRoles.push_back(PLAYER_ROLE_TANK);
+    while (healers++ < 1) neededRoles.push_back(PLAYER_ROLE_HEALER);
+    while (damage++ < 3) neededRoles.push_back(PLAYER_ROLE_DAMAGE);
+
+    uint32 const freeGroupSlots = player->GetGroup() ? MAXGROUPSIZE - player->GetGroup()->GetMembersCount() : 4;
+    if (neededRoles.size() > freeGroupSlots)
+        neededRoles.resize(freeGroupSlots);
+
+    std::set<ObjectGuid> selectedBots;
+    for (uint32 neededRole : neededRoles)
+    {
+        Player* selected = nullptr;
+        for (auto const& entry : bots)
+        {
+            Player* candidate = entry.second;
+            if (!candidate || selectedBots.count(candidate->GetGUID()) ||
+                (!sRandomPlayerbotMgr.IsRandomBot(candidate) &&
+                    !sRandomPlayerbotMgr.IsSolitaryTemporaryBot(candidate->GetGUID().GetCounter())) ||
+                candidate->GetGroup() || candidate->InBattleground() || candidate->InBattlegroundQueue() ||
+                candidate->isDead() || candidate->IsBeingTeleported() ||
+                (candidate->GetMap() && candidate->GetMap()->Instanceable()) ||
+                sLFGMgr->GetState(candidate->GetGUID()) != LFG_STATE_NONE || !CanFillRole(candidate, neededRole))
+                continue;
+
+            selected = candidate;
+            if (candidate->GetLevel() == player->GetLevel())
+                break;
+        }
+
+        if (!selected)
+        {
+            if (player->IsSolitary())
+                sRandomPlayerbotMgr.CreateSolitaryLfgActivityBot(player, neededRole, dungeons);
+            LOG_WARN("playerbots", "LFG instant fill: no free bot for role {} requested by {}", neededRole, player->GetName());
+            continue;
+        }
+
+        selectedBots.insert(selected->GetGUID());
+        if (selected->GetLevel() != player->GetLevel())
+        {
+            PlayerbotFactory levelFactory(selected, player->GetLevel());
+            levelFactory.Randomize(false);
+        }
+
+        PrepareRole(selected, neededRole);
+        if (PlayerbotAI* ai = GET_PLAYERBOT_AI(selected))
+            ai->ResetStrategies(false);
+        selected->SetSolitaryActivityBot(player->IsSolitary());
+        uint16 requestedItemLevel = player->IsSolitary()
+            ? std::max<uint16>(1, static_cast<uint16>(player->GetAverageItemLevel())) : 0;
+        EnsureLfgGear(selected, dungeons, requestedItemLevel);
+
+        std::string const gear = std::to_string(GET_PLAYERBOT_AI(selected)->GetEquipGearScore(selected));
+        LfgDungeonSet queueDungeons(dungeons.begin(), dungeons.end());
+        sLFGMgr->JoinLfg(selected, uint8(neededRole), queueDungeons, gear);
+        selected->SaveToDB(false, false);
+        LOG_INFO("playerbots", "LFG instant fill: {} queued for {} as role {}, level {}, ilvl {}",
+                 selected->GetName(), player->GetName(), neededRole, selected->GetLevel(), gear);
+    }
+}
+
+bool LfgJoinAction::EnsureLfgGear(Player* bot, std::set<uint32> const& dungeons, uint16 requestedItemLevel)
+{
+    if (!bot || !GET_PLAYERBOT_AI(bot))
+        return false;
+
+    uint16 targetItemLevel = requestedItemLevel ? requestedItemLevel : (bot->GetLevel() >= 80 ? 200 :
+        (bot->GetLevel() >= 70 ? 155 + (bot->GetLevel() - 70) * 4 :
+        (bot->GetLevel() >= 60 ? 85 + (bot->GetLevel() - 60) * 3 : bot->GetLevel() + 10)));
+
+    for (uint32 dungeonId : dungeons)
+    {
+        LFGDungeonEntry const* dungeon = sLFGDungeonStore.LookupEntry(dungeonId & 0x00FFFFFF);
+        if (!dungeon)
+            continue;
+
+        if (DungeonProgressionRequirements const* requirement =
+                sObjectMgr->GetAccessRequirement(dungeon->MapID, Difficulty(dungeon->Difficulty)))
+        {
+            if (requirement->reqItemLevel)
+                targetItemLevel = std::max<uint16>(targetItemLevel, requirement->reqItemLevel + 10);
+        }
+    }
+
+    if (!requestedItemLevel)
+        targetItemLevel = std::min<uint16>(targetItemLevel, 232);
+
+    if (bot->IsSolitaryActivityBot())
+    {
+        uint16 const tierId = SelectSolitaryGearTier(false, targetItemLevel);
+        return ApplySolitaryGearTemplate(bot, false, tierId, targetItemLevel, GetRolesForPlayer(bot));
+    }
+
+    PlayerbotAI* botAI = GET_PLAYERBOT_AI(bot);
+    uint32 const oldItemLevel = botAI->GetEquipGearScore(bot);
+    if (oldItemLevel >= targetItemLevel)
+        return false;
+
+    uint32 const gearScoreLimit = PlayerbotFactory::CalcMixedGearScore(targetItemLevel, ITEM_QUALITY_EPIC);
+    PlayerbotFactory factory(bot, bot->GetLevel(), ITEM_QUALITY_EPIC, gearScoreLimit);
+    factory.InitEquipment(false, true);
+    factory.ApplyEnchantAndGemsNew();
+    bot->DurabilityRepairAll(false, 1.0f, false);
+    bot->SaveToDB(false, false);
+
+    LOG_INFO("playerbots", "LFG autogear: {} level {}, average item level {} -> {} (target {})",
+             bot->GetName(), bot->GetLevel(), oldItemLevel, botAI->GetEquipGearScore(bot), targetItemLevel);
+    return true;
+}
+
+void LfgJoinAction::PrepareRole(Player* bot, uint32 role)
+{
+    if (bot)
+        PlayerbotFactory::InitTalentsBySpecNo(bot, SpecForRole(bot, role), true);
+}
+
+bool LfgJoinAction::EnsurePvpGear(Player* bot, uint16 targetItemLevel)
+{
+    if (!bot || !GET_PLAYERBOT_AI(bot))
+        return false;
+
+    bool const isJestokyzza = bot->GetName() == "Jestokyzza" &&
+        bot->GetSession() && !bot->GetSession()->IsBot();
+    if (!targetItemLevel)
+        targetItemLevel = isJestokyzza ? 277 : (bot->GetLevel() >= 80 ? 200 :
+            (bot->GetLevel() >= 70 ? 155 + (bot->GetLevel() - 70) * 4 :
+            (bot->GetLevel() >= 60 ? 85 + (bot->GetLevel() - 60) * 3 : bot->GetLevel() + 10)));
+    if (!isJestokyzza && !bot->IsSolitaryActivityBot())
+        targetItemLevel = std::min<uint16>(targetItemLevel, 232);
+
+    if (bot->IsSolitaryActivityBot())
+    {
+        uint16 const tierId = SelectSolitaryGearTier(true, targetItemLevel);
+        if (!ApplySolitaryGearTemplate(bot, true, tierId, targetItemLevel))
+            return false;
+
+        uint32 const newItemLevel = GET_PLAYERBOT_AI(bot)->GetEquipGearScore(bot);
+        uint8 const equipped = CountPvpEquipment(bot);
+        bool const hasWeapon = bot->GetItemByPos(INVENTORY_SLOT_BAG_0, EQUIPMENT_SLOT_MAINHAND) != nullptr;
+        bool const ready = equipped >= 14 && hasWeapon;
+        LOG_INFO("playerbots",
+            "PvP template prepare: {} average item level {}, combat slots {}, weapon {}, ready {}",
+            bot->GetName(), newItemLevel, equipped, hasWeapon, ready);
+        return ready;
+    }
+
+    PlayerbotAI* botAI = GET_PLAYERBOT_AI(bot);
+    uint32 oldItemLevel = botAI->GetEquipGearScore(bot);
+    uint32 gearScoreLimit = PlayerbotFactory::CalcMixedGearScore(targetItemLevel, ITEM_QUALITY_EPIC);
+    PlayerbotFactory factory(bot, bot->GetLevel(), ITEM_QUALITY_EPIC, gearScoreLimit);
+
+    // Keep a sufficiently strong existing set, but always run the enhancement
+    // pass. Randomize/level changes can produce socketed gear without gems and
+    // items without permanent enchants even when the average ilvl is adequate.
+    if (oldItemLevel < targetItemLevel)
+    {
+        // The destructive second-chance pass deletes the current slot before
+        // proving that a replacement exists. A sparse item cache could
+        // therefore send a bot into an arena wearing only its shirt.
+        factory.InitEquipment(false, false);
+    }
+
+    factory.ApplyEnchantAndGemsNew();
+    bot->DurabilityRepairAll(false, 1.0f, false);
+    bot->SaveToDB(false, false);
+
+    uint32 const newItemLevel = botAI->GetEquipGearScore(bot);
+    uint8 const equipped = CountPvpEquipment(bot);
+    bool const hasWeapon = bot->GetItemByPos(INVENTORY_SLOT_BAG_0, EQUIPMENT_SLOT_MAINHAND) != nullptr;
+    uint32 const minimumItemLevel = std::min<uint32>(targetItemLevel, 200);
+    bool const ready = equipped >= 14 && hasWeapon && newItemLevel >= minimumItemLevel;
+
+    LOG_INFO("playerbots",
+        "PvP prepare: {} level {}, average item level {} -> {}, combat slots {}, weapon {}, ready {}; "
+        "enchants/gems applied",
+        bot->GetName(), bot->GetLevel(), oldItemLevel, newItemLevel, equipped, hasWeapon, ready);
+    return ready;
+}
