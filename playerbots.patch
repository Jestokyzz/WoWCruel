+    // Roles 0x101.. are assigned deterministically at request time.  The
+    // first `type - 1` bots are allies of the real player; the next `type`
+    // bots are the opponent team.  Only its first member may be captain.
+    uint32 const captainPosition = owner->second.lfgRole >= 0x100 ? owner->second.lfgRole - 0x100 : 0;
+    if (captainPosition != static_cast<uint32>(type))
+        return false;
