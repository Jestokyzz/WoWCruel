+bool PlayerbotFactory::ApplyEquipmentTemplate(uint32 templateId)
+{
+    QueryResult templateResult = WorldDatabase.Query(
+        "SELECT class_id, required_equipment_slots "
+        "FROM solitary_bot_gear_template WHERE template_id = {} AND verified = 1",
+        templateId);
+    if (!templateResult)
+    {
+        LOG_ERROR("playerbots", "Solitary template {} is missing or is not verified", templateId);
+        return false;
+    }
+
+    Field* templateFields = templateResult->Fetch();
+    uint8 const classId = templateFields[0].Get<uint8>();
+    uint8 const requiredSlots = templateFields[1].Get<uint8>();
+    if (classId != bot->getClass())
+    {
+        LOG_ERROR("playerbots", "Solitary template {} belongs to class {}, bot {} is class {}",
+            templateId, classId, bot->GetName(), bot->getClass());
+        return false;
+    }
+
+    QueryResult itemResult = WorldDatabase.Query(
+        "SELECT equipment_slot, item_entry "
+        "FROM solitary_bot_gear_template_item WHERE template_id = {}",
+        templateId);
+    if (!itemResult)
+    {
+        LOG_ERROR("playerbots", "Solitary template {} has no equipment rows", templateId);
+        return false;
+    }
+
+    std::unordered_map<uint8, uint32> templateItems;
+    std::unordered_map<uint32, uint32> templateLimitCategories;
+    do
+    {
+        Field* fields = itemResult->Fetch();
+        uint8 const slot = fields[0].Get<uint8>();
+        uint32 const itemEntry = fields[1].Get<uint32>();
+        ItemTemplate const* itemTemplate = sObjectMgr->GetItemTemplate(itemEntry);
+        if (slot >= EQUIPMENT_SLOT_END || slot == EQUIPMENT_SLOT_BODY || slot == EQUIPMENT_SLOT_TABARD ||
+            !itemTemplate || !CanEquipItem(itemTemplate) ||
+            (itemTemplate->Class == ITEM_CLASS_ARMOR && !CanEquipArmor(itemTemplate)) ||
+            (itemTemplate->Class == ITEM_CLASS_WEAPON && !CanEquipWeapon(itemTemplate)))
+        {
+            LOG_ERROR("playerbots", "Solitary template {} failed preflight at slot {}, item {} for {}",
+                templateId, slot, itemEntry, bot->GetName());
+            return false;
+        }
+        if (itemTemplate->ItemLimitCategory)
+        {
+            ItemLimitCategoryEntry const* limit =
+                sItemLimitCategoryStore.LookupEntry(itemTemplate->ItemLimitCategory);
+            uint32 const selected = ++templateLimitCategories[itemTemplate->ItemLimitCategory];
+            if (!limit || selected > limit->maxCount)
+            {
+                LOG_ERROR("playerbots",
+                    "Solitary template {} exceeds item limit category {} at slot {}, item {} ({} selected, max {})",
+                    templateId, itemTemplate->ItemLimitCategory, slot, itemEntry, selected,
+                    limit ? limit->maxCount : 0);
+                return false;
+            }
+        }
+        templateItems[slot] = itemEntry;
+    } while (itemResult->NextRow());
+
+    if (templateItems.size() < requiredSlots || !templateItems.contains(EQUIPMENT_SLOT_MAINHAND))
+    {
+        LOG_ERROR("playerbots", "Solitary template {} is incomplete: {} slots, required {}",
+            templateId, templateItems.size(), requiredSlots);
+        return false;
+    }
+
+    bool alreadyEquipped = true;
+    for (auto const& [slot, itemEntry] : templateItems)
+    {
+        Item const* item = bot->GetItemByPos(INVENTORY_SLOT_BAG_0, slot);
+        if (!item || item->GetEntry() != itemEntry)
