+            (it->second.requestedAt && now > it->second.requestedAt + 60))
+        {
+            LOG_ERROR("playerbots",
+                "Solitary arena: cancelled cohort preparation for {} after repeated failures or timeout",
+                requester->GetName());
+            cancelPreparation(
+                "Не удалось подготовить полную команду ботов для режима \"Одиночка\". "
+                "Регистрация отменена; попробуйте снова.");
+            it = pendingSolitaryArenaRegistrations.erase(it);
+            continue;
+        }
+
+        if (requester->InBattlegroundQueue())
+        {
+            BattlegroundQueue& queue = sBattlegroundMgr->GetBattlegroundQueue(queueType);
+            GroupQueueInfo pendingInfo;
+            bool const exactVisiblePlaceholder =
+                requester->InBattlegroundQueueForBattlegroundQueueType(queueType) &&
+                queue.GetPlayerGroupInfoData(requester->GetGUID(), &pendingInfo) &&
+                pendingInfo.IsSolitary && pendingInfo.IsRated == it->second.rated &&
+                pendingInfo.ArenaType == it->second.teamSize && pendingInfo.Players.size() == 1;
+            if (!exactVisiblePlaceholder)
+            {
+                scheduleOwnerCleanup();
+                it = pendingSolitaryArenaRegistrations.erase(it);
+                continue;
+            }
+        }
+        uint8 const required = it->second.rated ? it->second.teamSize * 2 - 1 : it->second.teamSize - 1;
+        uint16 const targetItemLevel = std::max<uint16>(
+            1, static_cast<uint16>(requester->GetAverageItemLevel()));
+        std::vector<Player*> cohort;
+        std::set<uint32> cohortRoles;
+        for (auto const& [guid, bot] : playerBots)
+        {
+            if (!bot || !bot->GetSession() || !bot->GetSession()->IsBot() || !bot->IsInWorld() ||
+                bot->GetGroup() || bot->InBattlegroundQueue() || bot->InBattleground() ||
+                bot->GetLevel() != requester->GetLevel() || bot->GetTeamId() != requester->GetTeamId())
+                continue;
+
+            if (!IsSolitaryTemporaryBotFor(guid.GetCounter(), requester->GetGUID().GetCounter(),
+                    queueType, it->second.rated))
+                continue;
+
+            auto const botInfo = solitaryTemporaryBots.find(guid.GetCounter());
+            uint32 const role = botInfo->second.lfgRole;
+            if (role <= 0x100u || role > 0x100u + required ||
+                solitaryAccountsPendingCleanup.contains(botInfo->second.accountId))
+                continue;
+
+            PlayerbotAI* ai = GET_PLAYERBOT_AI(bot);
+            if (!ai)
+                continue;
+            if (!LfgJoinAction::EnsurePvpGear(bot, targetItemLevel))
+            {
+                uint8& failures = it->second.preparationFailures[role];
+                ++failures;
+                if (failures >= 3)
+                    it->second.terminalFailure = true;
+                solitaryAccountsPendingCleanup.insert(botInfo->second.accountId);
+                LOG_ERROR("playerbots",
+                    "Solitary arena: bot {} failed final gear verification for position {} (attempt {}/3)",
+                    bot->GetName(), role - 0x100u, failures);
+                continue;
+            }
+            if (!cohortRoles.insert(role).second)
+                continue;
+
+            if (!bot->IsAlive())
+                Revive(bot);
+            ai->Reset();
+            ai->ResetStrategies(false);
+            cohort.push_back(bot);
+        }
+
+        std::sort(cohort.begin(), cohort.end(), [this](Player const* left, Player const* right)
+        {
+            return solitaryTemporaryBots.at(left->GetGUID().GetCounter()).lfgRole <
+                solitaryTemporaryBots.at(right->GetGUID().GetCounter()).lfgRole;
+        });
+
+        if (cohort.size() < required)
+        {
+            std::set<uint32> trackedRoles;
+            for (auto const& [guid, info] : solitaryTemporaryBots)
+            {
+                if (info.ownerGuid != requester->GetGUID().GetCounter() || info.queueType != queueType ||
+                    info.rated != it->second.rated || !info.gearTemplateId ||
+                    solitaryAccountsPendingCleanup.contains(info.accountId))
+                    continue;
+                if (info.lfgRole > 0x100u && info.lfgRole <= 0x100u + required)
+                    trackedRoles.insert(info.lfgRole);
+            }
+            for (PendingSolitaryActivityBot const& pending : pendingSolitaryActivityBots)
+            {
+                if (!pending.warmReserve && pending.info.ownerGuid == requester->GetGUID().GetCounter() &&
+                    pending.info.queueType == queueType && pending.info.rated == it->second.rated &&
+                    !solitaryAccountsPendingCleanup.contains(pending.info.accountId) &&
+                    pending.info.lfgRole > 0x100u && pending.info.lfgRole <= 0x100u + required)
+                    trackedRoles.insert(pending.info.lfgRole);
+            }
+
+            uint8 deficit = 0;
+            for (uint8 position = 1; position <= required; ++position)
+                if (!trackedRoles.contains(0x100u + position))
+                    ++deficit;
+            if (deficit)
+            {
+                LOG_INFO("playerbots",
+                    "Solitary arena: replenishing isolated cohort for {} with {} replacement bots ({} of {} ready)",
+                    requester->GetName(), deficit, cohort.size(), required);
+                for (uint8 position = 1; position <= required; ++position)
+                {
+                    uint32 const role = 0x100u + position;
+                    if (trackedRoles.contains(role))
+                        continue;
+                    CreateSolitaryActivityBotInternal(requester, requester->GetTeamId(), queueType,
+                        it->second.rated, role, {});
+                }
+            }
+            ++it;
+            continue;
+        }
+
+        for (Player* readyBot : cohort)
+        {
+            SolitaryActivityBotInfo const& readyInfo =
+                solitaryTemporaryBots.at(readyBot->GetGUID().GetCounter());
+            LOG_INFO("playerbots",
+                "Solitary arena readiness: owner {}, position {}, bot {}, class {}, template {}, "
+                "average ilvl {}, target ilvl {}, post-entry arena AI pending",
+                requester->GetName(), readyInfo.lfgRole - 0x100u, readyBot->GetName(),
+                readyBot->getClass(), readyInfo.gearTemplateId,
+                static_cast<uint32>(readyBot->GetAverageItemLevel()), targetItemLevel);
+        }
+
+        Group* group = new Group();
+        group->SetSolitaryActivityGroup(true);
+        if (!group->Create(requester))
+        {
+            delete group;
+            ++it;
+            continue;
+        }
+        sGroupMgr->AddGroup(group);
+
+        bool groupReady = true;
+        for (uint8 index = 0; index < it->second.teamSize - 1; ++index)
+        {
+            if (!group->AddMember(cohort[index]))
+            {
+                groupReady = false;
+                break;
+            }
+        }
+        if (!groupReady)
+        {
+            group->Disband();
+            ++it;
+            continue;
+        }
+
+        LOG_INFO("playerbots",
+            "Solitary arena: prepared isolated cohort for {}: {} allied bots, {} opponent bots, target ilvl {}",
+            requester->GetName(), it->second.teamSize - 1,
+            it->second.rated ? it->second.teamSize : 0, targetItemLevel);
+
+        PendingSolitaryArenaRegistration registration = it->second;
+        requester->GetSession()->CompletePendingSolitaryArenaJoin(registration.battlemasterGuid,
+            registration.arenaSlot, registration.rated);
+        if (requester->InBattlegroundQueue())
+            it = pendingSolitaryArenaRegistrations.erase(it);
+        else
+            ++it;
+    }
+}
+
+void RandomPlayerbotMgr::ScheduleSolitaryActivityBotCleanup(Player* bot)
+{
+    if (!bot)
+        return;
+    auto found = solitaryTemporaryBots.find(bot->GetGUID().GetCounter());
+    if (found == solitaryTemporaryBots.end())
+    {
+        bot->SetSolitaryActivityBot(false);
+        return;
+    }
+    solitaryAccountsPendingCleanup.insert(found->second.accountId);
+}
+
+void RandomPlayerbotMgr::CleanupOrphanedSolitaryActivityBots()
+{
+    QueryResult result = CharacterDatabase.Query(
+        "SELECT account_id, guid, lifecycle_state, owner_guid FROM character_solitary_activity_bot");
+    if (result)
+    {
+        std::set<uint32> accounts;
+        std::set<uint32> arenaTeams;
+        do
+        {
+            Field* fields = result->Fetch();
+            uint32 accountId = fields[0].Get<uint32>();
+            ObjectGuid guid = ObjectGuid::Create<HighGuid::Player>(fields[1].Get<uint32>());
+            uint8 lifecycle = fields[2].Get<uint8>();
+            ObjectGuid::LowType ownerGuid = fields[3].Get<uint32>();
+            if (lifecycle == 1 && ownerGuid == 0)
+                continue;
+            accounts.insert(accountId);
+            for (uint8 arenaSlot = 0; arenaSlot < MAX_ARENA_SLOT; ++arenaSlot)
+            {
+                uint32 arenaTeamId = sCharacterCache->GetCharacterArenaTeamIdByGuid(guid, arenaSlot);
+                if (arenaTeamId)
+                    arenaTeams.insert(arenaTeamId);
+            }
+        } while (result->NextRow());
+
+        for (uint32 arenaTeamId : arenaTeams)
+        {
+            if (ArenaTeam* team = sArenaTeamMgr->GetArenaTeamById(arenaTeamId))
+            {
+                team->Disband();
+                delete team;
+            }
+        }
+
+        for (uint32 accountId : accounts)
+        {
+            AccountMgr::DeleteAccount(accountId);
+            CharacterDatabase.DirectExecute(
+                "DELETE FROM character_solitary_activity_bot WHERE account_id = {}", accountId);
+            LOG_INFO("playerbots", "Solitary activity startup reaper: deleted orphaned account {}", accountId);
+        }
+    }
+    CharacterDatabase.DirectExecute(
+        "UPDATE solitary_bot_name_pool SET state = 0, reservation_token = NULL, reserved_at = NULL "
+        "WHERE state = 1");
 }
 
