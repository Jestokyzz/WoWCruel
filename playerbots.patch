-        RandomPlayerbotFactory::DeleteBotArenaTeams();
+        if (!bot || bot->GetTeamId() != captain->GetTeamId() || bot->GetGroup() ||
+            bot->InBattlegroundQueue() || bot->InBattleground())
+            continue;
+
+        auto info = solitaryTemporaryBots.find(guid.GetCounter());
+        if (info == solitaryTemporaryBots.end() || !info->second.rated ||
+            info->second.ownerGuid != owner->second.ownerGuid || info->second.queueType != owner->second.queueType)
+            continue;
+
+        uint32 const position = info->second.lfgRole >= 0x100 ? info->second.lfgRole - 0x100 : 0;
+        if (position >= static_cast<uint32>(type) && position < static_cast<uint32>(type) * 2)
+            orderedMembers.emplace_back(position, bot);
+    }
+
+    std::sort(orderedMembers.begin(), orderedMembers.end(),
+        [](auto const& left, auto const& right) { return left.first < right.first; });
