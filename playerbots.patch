+            alreadyEquipped = false;
+            break;
+        }
+    }
+    if (alreadyEquipped)
+        return true;
+
+    std::vector<std::pair<uint8, uint32>> previousEquipment;
+    for (uint8 slot = EQUIPMENT_SLOT_START; slot < EQUIPMENT_SLOT_END; ++slot)
+    {
+        if (slot == EQUIPMENT_SLOT_BODY || slot == EQUIPMENT_SLOT_TABARD)
+            continue;
+        if (Item* item = bot->GetItemByPos(INVENTORY_SLOT_BAG_0, slot))
+            previousEquipment.emplace_back(slot, item->GetEntry());
+    }
+
+    auto clearCombatEquipment = [this]()
+    {
+        for (uint8 slot = EQUIPMENT_SLOT_START; slot < EQUIPMENT_SLOT_END; ++slot)
+        {
+            if (slot == EQUIPMENT_SLOT_BODY || slot == EQUIPMENT_SLOT_TABARD)
+                continue;
+            if (bot->GetItemByPos(INVENTORY_SLOT_BAG_0, slot))
+                bot->DestroyItem(INVENTORY_SLOT_BAG_0, slot, true);
+        }
+    };
+
+    // Website-derived best-in-slot sets legitimately contain profession and
+    // reputation rewards. Disposable activity bots have no progression
+    // history, so satisfy only the exact requirements of the verified set.
+    // This is scoped to synthetic bots and never touches a real player.
+    for (auto const& [slot, itemEntry] : templateItems)
+    {
+        (void)slot;
+        ItemTemplate const* itemTemplate = sObjectMgr->GetItemTemplate(itemEntry);
+        if (itemTemplate->RequiredSkill &&
+            bot->GetSkillValue(itemTemplate->RequiredSkill) < itemTemplate->RequiredSkillRank)
+        {
+            if (!IsPrimaryTradeSkill(itemTemplate->RequiredSkill))
+            {
+                LOG_ERROR("playerbots", "Solitary template {} requires unsupported skill {} for item {}",
+                    templateId, itemTemplate->RequiredSkill, itemEntry);
+                return false;
+            }
+            uint16 const value = std::max<uint16>(1, itemTemplate->RequiredSkillRank);
+            bot->SetSkill(itemTemplate->RequiredSkill, 6, value, std::max<uint16>(450, value));
+        }
+        if (itemTemplate->RequiredReputationFaction &&
+            uint32(bot->GetReputationRank(itemTemplate->RequiredReputationFaction)) <
+                itemTemplate->RequiredReputationRank)
+        {
+            FactionEntry const* faction =
+                sFactionStore.LookupEntry(itemTemplate->RequiredReputationFaction);
+            if (!faction || itemTemplate->RequiredReputationRank > REP_EXALTED)
+            {
+                LOG_ERROR("playerbots", "Solitary template {} has invalid reputation requirement for item {}",
+                    templateId, itemEntry);
+                return false;
+            }
+            ReputationRank const rank =
+                static_cast<ReputationRank>(itemTemplate->RequiredReputationRank);
+            int32 const standing = rank == REP_HATED ? ReputationMgr::Reputation_Bottom :
+                ReputationMgr::ReputationRankToStanding(static_cast<ReputationRank>(rank - 1)) + 1;
+            bot->GetReputationMgr().SetReputation(faction, standing);
+        }
+    }
+
+    auto equipItems = [this](std::unordered_map<uint8, uint32> const& items)
+    {
+        for (uint8 slot : initSlotsOrder)
+        {
+            auto found = items.find(slot);
+            if (found == items.end())
+                continue;
+
+            uint16 destination = 0;
+            InventoryResult equipResult = EQUIP_ERR_OK;
+            if (!CanEquipUnseenItem(slot, destination, found->second, &equipResult))
+            {
+                LOG_ERROR("playerbots",
+                    "Solitary equipment failed CanEquip at slot {}, item {} for {} (InventoryResult {})",
+                    slot, found->second, bot->GetName(), static_cast<uint32>(equipResult));
+                return false;
+            }
+            Item* item = bot->EquipNewItem(destination, found->second, true);
+            if (!item)
+            {
+                LOG_ERROR("playerbots", "Solitary equipment failed EquipNewItem at slot {}, item {} for {}",
+                    slot, found->second, bot->GetName());
+                return false;
+            }
+            item->SetOwnerGUID(bot->GetGUID());
+            bot->AutoUnequipOffhandIfNeed();
+        }
+        return true;
+    };
+
+    clearCombatEquipment();
+    // Randomization can leave a different item from the same limit category in
+    // a bag. For MODE_HAVE categories that blocks the verified item even after
+    // worn gear was cleared. Remove exact copies and every conflicting category
+    // item from this disposable bot before the atomic equip pass.
+    class DestroyTemplateConflictsVisitor : public IterateItemsVisitor
+    {
+    public:
+        DestroyTemplateConflictsVisitor(Player* owner, std::unordered_map<uint8, uint32> const& items,
+            std::unordered_map<uint32, uint32> const& categories) : owner(owner), categories(categories)
+        {
+            for (auto const& [slot, entry] : items)
+            {
+                (void)slot;
+                entries.insert(entry);
+            }
+        }
+
+        bool Visit(Item* item) override
+        {
+            ItemTemplate const* itemTemplate = item ? item->GetTemplate() : nullptr;
+            if (!itemTemplate)
+                return true;
+            if (!entries.contains(itemTemplate->ItemId) &&
+                (!itemTemplate->ItemLimitCategory || !categories.contains(itemTemplate->ItemLimitCategory)))
+                return true;
+            owner->DestroyItem(item->GetBagSlot(), item->GetSlot(), true);
+            return true;
+        }
+
+    private:
+        Player* owner;
+        std::unordered_set<uint32> entries;
+        std::unordered_map<uint32, uint32> const& categories;
+    };
+    DestroyTemplateConflictsVisitor conflictVisitor(bot, templateItems, templateLimitCategories);
+    IterateItems(&conflictVisitor);
+    if (!equipItems(templateItems))
+    {
+        clearCombatEquipment();
+        std::unordered_map<uint8, uint32> restoreItems;
+        for (auto const& [slot, itemEntry] : previousEquipment)
+            restoreItems[slot] = itemEntry;
+        bool const restored = equipItems(restoreItems);
+        LOG_ERROR("playerbots", "Solitary template {} failed while equipping {}; previous set restored: {}",
+            templateId, bot->GetName(), restored);
+        return false;
+    }
+
+    LOG_INFO("playerbots", "Solitary template {} equipped on {} with {} combat items",
+        templateId, bot->GetName(), templateItems.size());
+    return true;
+}
