+void RandomPlayerbotMgr::MaintainSolitaryActivityBotReserve()
+{
+    time_t const now = time(nullptr);
+    if (now < solitaryReserveCheckAt)
+        return;
+    solitaryReserveCheckAt = now + 1;
+
+    uint32 const target = sPlayerbotAIConfig.solitaryActivityWarmReservePerFaction;
+    uint32 budget = sPlayerbotAIConfig.solitaryActivityWarmReserveCreatePerTick;
+    if (!target || !budget)
+        return;
+
+    static uint8 const classes[] = {
+        CLASS_WARRIOR, CLASS_PRIEST, CLASS_MAGE, CLASS_ROGUE, CLASS_PALADIN,
+        CLASS_SHAMAN, CLASS_DRUID, CLASS_HUNTER, CLASS_WARLOCK, CLASS_DEATH_KNIGHT
+    };
+    static TeamId const teams[] = { TEAM_ALLIANCE, TEAM_HORDE };
+
+    for (TeamId team : teams)
+    {
+        QueryResult readyResult = CharacterDatabase.Query(
+            "SELECT class_id, COUNT(*) FROM character_solitary_activity_bot "
+            "WHERE lifecycle_state = 1 AND owner_guid = 0 AND team_id = {} GROUP BY class_id",
+            static_cast<uint32>(team));
+        std::unordered_map<uint8, uint32> classCounts;
+        uint32 ready = 0;
+        if (readyResult)
+        {
+            do
+            {
+                Field* fields = readyResult->Fetch();
+                uint32 const count = fields[1].Get<uint32>();
+                classCounts[fields[0].Get<uint8>()] += count;
+                ready += count;
+            } while (readyResult->NextRow());
+        }
+        for (PendingSolitaryActivityBot const& item : pendingSolitaryActivityBots)
+            if (item.warmReserve && item.team == team)
+            {
+                ++ready;
+                ++classCounts[item.classId];
+            }
+
+        while (ready < target && budget)
+        {
+            PendingSolitaryActivityBot pending;
+            pending.warmReserve = true;
+            pending.team = team;
+            pending.info.team = team;
+            pending.classId = classes[0];
+            for (uint8 cls : classes)
+                if (classCounts[cls] < classCounts[pending.classId])
+                    pending.classId = cls;
+            pending.info.classId = pending.classId;
+            pending.info.createdAt = now;
+            if (!QueueSolitaryActivityBotCreation(std::move(pending), "background warm reserve"))
+            {
+                solitaryReserveCheckAt = now + 30;
+                return;
+            }
+            ++classCounts[pending.classId];
+            ++ready;
+            --budget;
+        }
+        if (!budget)
+            break;
+    }
+}
+
+void RandomPlayerbotMgr::ProcessSolitaryActivityBots()
+{
+    MaintainSolitaryActivityBotReserve();
+
+    for (auto& [guid, info] : solitaryTemporaryBots)
+    {
+        Player* bot = GetPlayerBot(guid);
+        if (!bot)
+            continue;
+
+        // ArenaTactics removes itself when it is run before the queued bot has
+        // actually been ported. Arm the complete class/spec strategy set only
+        // after the core reports the disposable bot inside an arena instance.
+        if (bot->InArena())
+        {
+            PlayerbotAI* ai = GET_PLAYERBOT_AI(bot);
+            if (ai && (!ai->HasStrategy("arena", BOT_STATE_COMBAT) ||
+                       !ai->HasStrategy("arena", BOT_STATE_NON_COMBAT)))
+            {
+                ai->Reset();
+                ai->ResetStrategies(false);
+                LOG_INFO("playerbots",
+                    "Solitary arena: post-entry AI initialized for {} (class {}, combat arena {}, "
+                    "non-combat arena {})",
+                    bot->GetName(), bot->getClass(),
+                    ai->HasStrategy("arena", BOT_STATE_COMBAT) ? 1 : 0,
+                    ai->HasStrategy("arena", BOT_STATE_NON_COMBAT) ? 1 : 0);
+            }
+
+            time_t const now = time(nullptr);
+            if (ai && bot->IsInCombat() && now >= info.lastAiDiagnosticAt + 5)
+            {
+                info.lastAiDiagnosticAt = now;
+                GuidVector const possibleTargets =
+                    ai->GetAiObjectContext()->GetValue<GuidVector>("possible targets")->Get();
+                Unit* currentTarget =
+                    ai->GetAiObjectContext()->GetValue<Unit*>("current target")->Get();
+                LastSpellCast const& lastSpell =
+                    ai->GetAiObjectContext()->GetValue<LastSpellCast&>("last spell cast")->Get();
+                LOG_INFO("playerbots",
+                    "Solitary arena AI: {} possible targets {}, current target {}, victim {}, last spell {}",
+                    bot->GetName(), possibleTargets.size(), currentTarget ? currentTarget->GetGUID().ToString() : "none",
+                    bot->GetVictim() ? bot->GetVictim()->GetGUID().ToString() : "none", lastSpell.id);
+            }
+        }
+
+        if (info.queueType == BATTLEGROUND_QUEUE_NONE)
+        {
+            lfg::LfgState state = sLFGMgr->GetState(bot->GetGUID());
+            if (state != lfg::LFG_STATE_NONE || bot->GetGroup())
+            {
+                if (!info.engaged)
+                    CharacterDatabase.Execute(
+                        "UPDATE character_solitary_activity_bot SET lifecycle_state = 3 WHERE guid = {}",
+                        guid);
+                info.engaged = true;
+            }
+            else if (info.engaged)
+                solitaryAccountsPendingCleanup.insert(info.accountId);
+        }
+        else
+        {
+            if (bot->InBattlegroundQueue() || bot->InBattleground())
